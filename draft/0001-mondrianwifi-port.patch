diff --git c/arch/arm/boot/dts/qcom/qcom-msm8974-samsung-mondrianwifi.dts i/arch/arm/boot/dts/qcom/qcom-msm8974-samsung-mondrianwifi.dts
new file mode 100644
index 000000000..af3129748
--- /dev/null
+++ i/arch/arm/boot/dts/qcom/qcom-msm8974-samsung-mondrianwifi.dts
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Samsung Galaxy Tab Pro 8.4 Wi-Fi (SM-T320, "mondrianwifi")
+ * APQ8074 / msm8974 + PM8941 + PM8841
+ *
+ * DRAFT. Values traced from the downstream include chain
+ * (apq8074-sec-mondrianwifi-r12.dts -> msm8974-mdss-sec.dtsi,
+ *  msm8974-sec-mondrian-r12.dtsi, msm8974-sec-tabpro-common.dtsi)
+ * and cross-checked against live sysfs on the running device.
+ */
+
+/dts-v1/;
+
+#include "qcom-msm8974.dtsi"
+#include "pm8841.dtsi"
+#include "pm8941.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+
+/ {
+	model = "Samsung Galaxy Tab Pro 8.4";
+	compatible = "samsung,mondrianwifi", "qcom,apq8074";
+	chassis-type = "tablet";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&gpio_keys_pin_a>;
+		pinctrl-names = "default";
+
+		key-home {
+			label = "Home";
+			gpios = <&pm8941_gpios 3 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_HOMEPAGE>;
+			debounce-interval = <15>;
+		};
+
+		key-volume-down {
+			label = "Volume Down";
+			gpios = <&pm8941_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <15>;
+		};
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm8941_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+		};
+	};
+};
+
+/*
+ * Touchscreen. Downstream: synaptics@20 on i2c@f9924000 (== blsp1_i2c2),
+ * irq pm8941_gpios 30, avdd = l22 (3.3V live), vcc_i2c = l10 (1.85V live).
+ * Wiring is identical to qcom-msm8974-samsung-hlte.dts.
+ */
+&blsp1_i2c2 {
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+
+		interrupt-parent = <&pm8941_gpios>;
+		interrupts = <30 IRQ_TYPE_EDGE_FALLING>;
+
+		vdd-supply = <&pm8941_l22>;
+		vio-supply = <&pm8941_l10>;
+
+		pinctrl-0 = <&touch_pin>;
+		pinctrl-names = "default";
+
+		syna,startup-delay-ms = <100>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+		};
+	};
+};
+
+&pm8941_gpios {
+	gpio_keys_pin_a: gpio-keys-active-state {
+		pins = "gpio2", "gpio3", "gpio5";
+		function = "normal";
+		bias-pull-up;
+		power-source = <PM8941_GPIO_S3>;
+	};
+
+	touch_pin: touch-int-state {
+		pins = "gpio30";
+		function = "normal";
+		bias-disable;
+		input-enable;
+		power-source = <PM8941_GPIO_S3>;
+	};
+
+	panel_pin: panel-state {
+		pins = "gpio9", "gpio14";
+		function = "normal";
+		bias-disable;
+		power-source = <PM8941_GPIO_S3>;
+		output-high;
+	};
+};
+
+/*
+ * Rails. Voltages below were read from live sysfs on the running device
+ * (see tabpro84-port/findings/NOTES.md), not guessed:
+ *   l2 = 1.200V  l10 = 1.850V  l12 = 1.800V  l22 = 3.300V
+ */
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8841-regulators";
+
+		pm8841_s1: s1 {
+			regulator-min-microvolt = <675000>;
+			regulator-max-microvolt = <1050000>;
+		};
+
+		pm8841_s3: s3 {
+			regulator-min-microvolt = <1050000>;
+			regulator-max-microvolt = <1050000>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,rpm-pm8941-regulators";
+
+		pm8941_s1: s1 {
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+			regulator-always-on;
+		};
+
+		pm8941_s2: s2 {
+			regulator-min-microvolt = <2150000>;
+			regulator-max-microvolt = <2150000>;
+		};
+
+		pm8941_s3: s3 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
+		pm8941_l2: l2 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+		};
+
+		pm8941_l10: l10 {
+			regulator-min-microvolt = <1850000>;
+			regulator-max-microvolt = <1850000>;
+		};
+
+		pm8941_l12: l12 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
+		pm8941_l20: l20 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-system-load = <200000>;
+			regulator-allow-set-load;
+			regulator-boot-on;
+		};
+
+		pm8941_l22: l22 {
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-boot-on;
+		};
+
+		pm8941_l6: l6 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-boot-on;
+		};
+
+		pm8941_l24: l24 {
+			regulator-min-microvolt = <3075000>;
+			regulator-max-microvolt = <3075000>;
+			regulator-boot-on;
+		};
+	};
+};
+
+&blsp1_uart2 {
+	status = "okay";
+};
+
+&sdhc_1 {
+	status = "okay";
+
+	vmmc-supply = <&pm8941_l20>;
+	vqmmc-supply = <&pm8941_s3>;
+
+	pinctrl-0 = <&sdc1_on>;
+	pinctrl-names = "default";
+};
+
+&tlmm {
+	sdc1_on: sdc1-on-state {
+		clk-pins {
+			pins = "sdc1_clk";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		cmd-data-pins {
+			pins = "sdc1_cmd", "sdc1_data";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+	};
+};
+
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+
+	vdd-supply   = <&pm8941_l22>;
+	vddio-supply = <&pm8941_l12>;
+	vdda-supply  = <&pm8941_l2>;
+
+	panel@0 {
+		compatible = "samsung,r63319-tabpro84";
+		reg = <0>;
+
+		/* one physical panel, one reset and one enable shared by both links */
+		reset-gpios  = <&pm8941_gpios  9 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&pm8941_gpios 14 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply   = <&pm8941_l22>;
+		vddio-supply = <&pm8941_l12>;
+
+		pinctrl-0 = <&panel_pin>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				panel_in0: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				panel_in1: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in0>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+	vddio-supply = <&pm8941_l12>;
+};
+
+&mdss_dsi1 {
+	status = "okay";
+
+	vdd-supply   = <&pm8941_l22>;
+	vddio-supply = <&pm8941_l12>;
+	vdda-supply  = <&pm8941_l2>;
+};
+
+&mdss_dsi1_out {
+	remote-endpoint = <&panel_in1>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi1_phy {
+	status = "okay";
+	vddio-supply = <&pm8941_l12>;
+};
+
+/*
+ * USB. On a device with no exposed UART and no working display yet, USB
+ * networking from the initramfs is the ONLY way to tell whether the kernel
+ * booted at all. Copied from qcom-msm8974-samsung-lt03lte.dts, which is the
+ * same SoC and vendor and is a working pmOS port.
+ */
+&usb {
+	phys = <&usb_hs1_phy>;
+	phy-select = <&tcsr 0xb000 0>;
+
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+
+	status = "okay";
+};
+
+&usb_hs1_phy {
+	v1p8-supply = <&pm8941_l6>;
+	v3p3-supply = <&pm8941_l24>;
+
+	qcom,init-seq = /bits/ 8 <0x1 0x64>;
+
+	status = "okay";
+};
