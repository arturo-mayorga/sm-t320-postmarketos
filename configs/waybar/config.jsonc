{ "layer": "top", "position": "top", "height": 28,
  "modules-left": ["hyprland/workspaces"], "modules-center": ["clock"],
  "modules-right": ["custom/kbd", "network", "bluetooth", "wireplumber", "cpu", "memory", "battery"],
  "custom/kbd": { "format": " ⌨ ", "on-click": "pkill -SIGRTMIN wvkbd-mobintl", "tooltip": false },
  "network": { "format-wifi": "{essid} {signalStrength}%", "format-disconnected": "no wifi", "on-click": "alacritty -T tab-hw-wifi -e nmtui" },
  "bluetooth": { "format": "bt {status}", "format-connected": "bt {device_alias}", "on-click": "alacritty -T tab-hw-bluetooth -e bluetui" },
  "wireplumber": { "format": "vol {volume}%", "format-muted": "muted", "on-click": "alacritty -T tab-hw-audio -e pulsemixer" },
  "clock": { "format": "{:%H:%M}" }, "cpu": { "format": "cpu {usage}%" },
  "memory": { "format": "mem {}%" }, "battery": { "format": "bat {capacity}%" } }
