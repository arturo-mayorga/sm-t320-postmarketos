#!/bin/sh
# Power key: short press toggles the screen (backlight) without cycling the
# panel. Suspend is deliberately not on the power key any more: it cycles the
# panel and that leaves it dark after a few rounds (see tab-screen). Use the
# system menu (Super+Escape) to suspend or power off.
exec 9>/tmp/tab-power-key.lock
flock -n 9 || exit 0
~/.local/bin/tab-screen toggle
sleep 1
