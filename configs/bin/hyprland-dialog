#!/bin/sh
# Stand-in for hyprland-guiutils' dialog (not packaged for armv7). Hyprland's
# ANR watchdog and permission prompts call this; show the text as a
# notification and answer nothing, which Hyprland treats as "no choice".
title=Hyprland; text=""
while [ $# -gt 0 ]; do
	case "$1" in
		--title) title=$2; shift 2 ;;
		--text) text=$2; shift 2 ;;
		--buttons) shift 2 ;;
		*) shift ;;
	esac
done
notify-send "$title" "$text" 2>/dev/null
exit 0
